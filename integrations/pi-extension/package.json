      "./skills"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Octen-Team/octen-js.git",
    "directory": "integrations/pi-extension"
  },
  "homepage": "https://github.com/Octen-Team/octen-js/tree/main/integrations/pi-extension#readme",
  "bugs": {
    "url": "https://github.com/Octen-Team/octen-js/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
